# Flags picked up by build-exe.ps1 for this tool.
#
# The workflow builds main.py, not "WIR Generate Tools.spec", so the spec's
# settings do not apply. Keep the two in step.

# A GUI program. Without this a console window opens behind the window.
--windowed

# PyInstaller reads the source for imports, which misses anything imported
# by name at runtime. pythoncom imports win32timezone the first time COM
# hands back a date, and nothing in the source ever mentions it.
--hidden-import win32timezone
--hidden-import pywintypes
--hidden-import pythoncom
--hidden-import win32api
--hidden-import win32con
--hidden-import win32com.client
--hidden-import win32com.client.dynamic
--hidden-import win32com.client.gencache

# The licence check verifies an Ed25519 signature.
--hidden-import cryptography
